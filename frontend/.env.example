# ─────────────────────────────────────────────────────────────
# frontend/.env.example
# Copy this file to .env and fill in only the values needed
# for the Next.js frontend. Most secrets live in backend/.env
# ─────────────────────────────────────────────────────────────

# URL of the deployed Fastify backend (used by Next.js rewrites in production)
# In development this defaults to http://localhost:3001 automatically
# On Vercel, set this to your backend's deployed URL (e.g. on Render)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Stellar Network ───────────────────────────────────────────
# Must match STELLAR_NETWORK in backend/.env. Drives every network-dependent
# value in the UI (Horizon reads, explorer links, the test USDC faucet) via
# src/lib/network.ts.
#
# Accepted values: "testnet" | "mainnet" — anything else resolves to testnet.
# NEXT_PUBLIC_* values are inlined at build time, so changing this requires a
# rebuild, not just a restart.
NEXT_PUBLIC_STELLAR_NETWORK="testnet"

# Horizon API endpoint — OPTIONAL.
# Leave unset to use the correct public endpoint for the network above.
# Set only to point at a private/paid Horizon instance.
# NEXT_PUBLIC_HORIZON_URL=""
